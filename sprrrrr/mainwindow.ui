      <property name="styleSheet">
       <string notr="true">QListView {
    background-color: #F6CFFC;        /* même fond rose clair */
    border: 2px solid #1E1E5A;        /* même bordure bleu foncé */
    border-radius: 10px;              /* arrondi identique */
    font-family: &quot;Arial&quot;;
    font-size: 18px;
    color: #0A0A2A;                    /* même couleur de texte */
    padding: 5px;
}

QListView::item {
    background-color: transparent;
    padding: 6px;
    border-radius: 6px;
}

QListView::item:selected {
    background-color: #1E1E5A;        /* même bleu foncé pour la sélection */
    color: white;
}

QListView::item:hover {
    background-color: #B38DFF;        /* violet clair sur hover */
    color: white;
}
</string>
      </property>
