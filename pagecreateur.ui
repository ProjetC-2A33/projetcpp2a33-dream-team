   <widget class="QTableView" name="tableView">
    <property name="geometry">
     <rect>
      <x>440</x>
      <y>230</y>
      <width>781</width>
      <height>201</height>
     </rect>
    </property>
    <property name="styleSheet">
     <string notr="true">/* Main Table View */
QTableView {
    background-color: #DAB1DA;
    color: #FFFFFF;
    font-size: 16px;
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;;
    border: none;
    border-radius: 15px;
    padding: 10px;
    gridline-color: #C78AC7;
    selection-background-color: #5555FF;
    alternate-background-color: #E8C8E8;
}

/* Table Cells */
QTableView::item {
    padding: 12px 15px;
    border: none;
    border-bottom: 1px solid #C78AC7;
}

QTableView::item:selected {
    background-color: #5555FF;
    color: #FFFFFF;
    font-weight: bold;
}

QTableView::item:hover {
    background-color: #E8C8E8;
    color: #000000;
}

/* Header Styling */
QHeaderView::section {
    background-color: #341539;
    color: #FFFFFF;
    padding: 14px 16px;
    font-weight: bold;
    font-size: 15px;
    border: none;
    border-right: 1px solid #4A1F4A;
    text-align: center;
}

QHeaderView::section:first {
    border-top-left-radius: 15px;
}

QHeaderView::section:last {
    border-top-right-radius: 15px;
    border-right: none;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #C78AC7;
    width: 14px;
    margin: 0px;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background: #341539;
    min-height: 30px;
    border-radius: 7px;
}

QScrollBar::handle:vertical:hover {
    background: #5555FF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Horizontal Scrollbar */
QScrollBar:horizontal {
    background: #C78AC7;
    height: 14px;
    margin: 0px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal {
    background: #341539;
    min-width: 30px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal:hover {
    background: #5555FF;
}</string>
    </property>
